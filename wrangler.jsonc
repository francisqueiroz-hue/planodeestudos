{
  // Configuração do Worker na Cloudflare. Substitua `database_id` pelo ID
  // retornado por `npx wrangler d1 create painel-de-estudos` antes do deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painel-de-estudos",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "painel-de-estudos",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "painel-de-estudos-arquivos"
    }
  ],
  "observability": { "enabled": true }
}
